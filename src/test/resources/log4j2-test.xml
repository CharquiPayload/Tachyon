<?xml version="1.0" encoding="UTF-8"?>
<!--
  The tests' logging: to the console, and nowhere else. Log4j reads this before any
  log4j2.xml; without it, the configuration Minecraft's jars bring onto the tests'
  classpath would write a logs/ folder into the project on every test run.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
